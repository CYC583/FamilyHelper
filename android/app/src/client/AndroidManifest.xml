<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Android 8/9 require this only when the user explicitly saves a photo. -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
    <!-- All privileged host components are absent from the client APK. -->
    <application>
        <receiver android:name="com.familyhelper.ClientPushReceiver" android:exported="true"
            android:permission="com.google.android.c2dm.permission.SEND">
            <intent-filter><action android:name="com.google.android.c2dm.intent.RECEIVE" /></intent-filter>
        </receiver>
        <service android:name="com.familyhelper.AlertSpeakJob"
            android:permission="android.permission.BIND_JOB_SERVICE" android:exported="false" />
    </application>
</manifest>
