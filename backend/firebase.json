{
  "functions": [{
    "source": "functions",
    "codebase": "familyhelper",
    "runtime": "nodejs22",
    "ignore": [
      "node_modules",
      ".git",
      "firebase-debug.log",
      "firebase-debug.*.log",
      ".env*",
      ".secret*",
      "**/.env*",
      "**/.secret*",
      "**/*.jks",
      "**/*.keystore",
      "**/*service-account*.json",
      "**/*serviceAccount*.json"
    ]
  }],
  "database": {"rules": "database.rules.json"},
  "storage": {"rules": "storage.rules"},
  "emulators": {"auth": {"port": 9099}, "functions": {"port": 5001}, "database": {"port": 9000}, "storage": {"port": 9199}, "ui": {"enabled": true}}
}
